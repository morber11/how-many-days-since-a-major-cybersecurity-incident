---
import Base from "../layouts/Base.astro";
import {
    formatDate,
    getIncidentCount,
    getMaxDaysBetweenIncidents,
    getMostCommonlyAffectedCompanies,
    getMostIncidentsInOneDay,
} from "../lib/counter";

const busiestDay = getMostIncidentsInOneDay();
const maxGap = getMaxDaysBetweenIncidents();
const commonCompanies = getMostCommonlyAffectedCompanies();
---

<Base title="hmdsamci - Stats">
    <div class="stats-page">
        <h1>Incident Statistics</h1>

        <div class="stats-grid">
            <section class="stats-card">
                <h2>Total incidents</h2>
                <p class="stats-value">{getIncidentCount()}</p>
            </section>

            <section class="stats-card">
                <h2>Most incidents in one day</h2>
                <p class="stats-value">{busiestDay.count}</p>
                <p class="stats-detail">{formatDate(busiestDay.date)}</p>
            </section>

            <section class="stats-card">
                <h2>Longest gap between incidents</h2>
                {
                    maxGap && (
                        <>
                            <p class="stats-value">{maxGap.days} days</p>
                            <p class="stats-detail">
                                From {formatDate(maxGap.dateA)} to{" "}
                                {formatDate(maxGap.dateB)}
                            </p>
                            <p class="stats-detail">
                                {maxGap.incidentA} =&gt; {maxGap.incidentB}
                            </p>
                        </>
                    )
                }
            </section>

            <section class="stats-card">
                <h2>
                    Most commonly affected {
                        commonCompanies.length === 1 ? "company" : "companies"
                    }
                </h2>
                <ul class="stats-company-list">
                    {
                        commonCompanies.map((entry) => (
                            <li>
                                <span>{entry.company}</span>
                                <span>{entry.count} incidents</span>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </div>
    </div>
</Base>

<style>
    .stats-page {
        padding-top: 2rem;
    }

    .stats-page h1 {
        font-family: var(--font-mono);
        font-size: 1.5rem;
        margin: 0 0 0.5rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .stats-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 1.5rem;
    }

    .stats-card h2 {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin: 0 0 1rem;
    }

    .stats-value {
        font-family: var(--font-mono);
        font-size: 2rem;
        line-height: 1.2;
        color: var(--color-accent);
        margin: 0;
    }

    .stats-detail {
        color: var(--color-text-muted);
        font-size: 0.85rem;
        margin: 0.5rem 0 0;
    }

    .stats-company-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .stats-company-list li {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-text);
        font-size: 0.9rem;
    }

    .stats-company-list li:first-child {
        padding-top: 0;
    }

    .stats-company-list li:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .stats-company-list li span:last-child {
        color: var(--color-text-muted);
        white-space: nowrap;
    }

    @media (max-width: 600px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
