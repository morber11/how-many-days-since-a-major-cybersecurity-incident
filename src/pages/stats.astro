---
import Base from "../layouts/Base.astro";
import {
    formatDate,
    getIncidentCount,
    getIncidentsPerMonth,
    getMaxDaysBetweenIncidents,
    getMostCommonlyAffectedCompanies,
    getMostIncidentsInOneDay,
} from "../lib/counter";

const busiestDay = getMostIncidentsInOneDay();
const maxGap = getMaxDaysBetweenIncidents();
const commonCompanies = getMostCommonlyAffectedCompanies();
const incidentsPerMonth = getIncidentsPerMonth();

let maxMonthCount = 0;
for (const entry of incidentsPerMonth) {
    maxMonthCount = Math.max(maxMonthCount, entry.count);
}

const chartPoints = incidentsPerMonth.map((entry, index) => ({
    count: entry.count,
    x: ((index + 0.5) / incidentsPerMonth.length) * 100,
    y: 100 - (entry.count / maxMonthCount) * 100,
}));

const yAxisTicks = [0, Math.round(maxMonthCount / 2), maxMonthCount];
---

<Base title="hmdsamci - Stats">
    <div class="stats-page">
        <h1>Incident Statistics</h1>

        <div class="stats-grid">
            <section class="stats-card">
                <h2>Total incidents</h2>
                <p class="stats-value">{getIncidentCount()}</p>
            </section>

            <section class="stats-card">
                <h2>Most incidents in one day</h2>
                <p class="stats-value">{busiestDay.count}</p>
                <p class="stats-detail">{formatDate(busiestDay.date)}</p>
            </section>

            <section class="stats-card">
                <h2>Longest gap between incidents</h2>
                {
                    maxGap && (
                        <>
                            <p class="stats-value">{maxGap.days} days</p>
                            <p class="stats-detail">
                                From {formatDate(maxGap.dateA)} to{" "}
                                {formatDate(maxGap.dateB)}
                            </p>
                            <p class="stats-detail">
                                {maxGap.incidentA} =&gt; {maxGap.incidentB}
                            </p>
                        </>
                    )
                }
            </section>

            <section class="stats-card">
                <h2>
                    Most commonly affected {
                        commonCompanies.length === 1 ? "company" : "companies"
                    }
                </h2>
                <ul class="stats-company-list">
                    {
                        commonCompanies.map((entry) => (
                            <li>
                                <span>{entry.company}</span>
                                <span>{entry.count} incidents</span>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="stats-card stats-card--wide">
                <h2>Incidents per month</h2>
                <div class="stats-chart">
                    <span class="stats-chart-y-title">Incidents</span>

                    <div class="stats-chart-y-ticks">
                        {
                            yAxisTicks.map((tick) => (
                                <span
                                    style={`bottom: ${(tick / maxMonthCount) * 100}%`}
                                >
                                    {tick}
                                </span>
                            ))
                        }
                    </div>

                    <div class="stats-chart-plot">
                        <svg
                            viewBox="0 0 100 100"
                            preserveAspectRatio="none"
                            aria-hidden="true"
                        >
                            <polyline
                                points={chartPoints
                                    .map((point) => `${point.x},${point.y}`)
                                    .join(" ")}></polyline>
                            {
                                chartPoints.map((point) => (
                                    <line
                                        x1={point.x}
                                        y1={point.y}
                                        x2={point.x}
                                        y2={point.y}
                                    />
                                ))
                            }
                        </svg>
                        {
                            chartPoints.map((point) => (
                                <span
                                    class="stats-chart-value"
                                    style={`left: ${point.x}%; bottom: ${100 - point.y}%`}
                                >
                                    {point.count}
                                </span>
                            ))
                        }
                    </div>

                    <ol
                        class="stats-chart-x-ticks"
                        style={`grid-template-columns: repeat(${incidentsPerMonth.length}, minmax(0, 1fr))`}
                    >
                        {
                            incidentsPerMonth.map((entry) => (
                                <li>
                                    {new Date(entry.month).toLocaleDateString(
                                        "en-GB",
                                        {
                                            month: "short",
                                            year: "2-digit",
                                            timeZone: "UTC",
                                        },
                                    )}
                                </li>
                            ))
                        }
                    </ol>

                    <span class="stats-chart-x-title">Month</span>
                </div>
            </section>
        </div>
    </div>
</Base>

<style>
    .stats-page {
        padding-top: 2rem;
    }

    .stats-page h1 {
        font-family: var(--font-mono);
        font-size: 1.5rem;
        margin: 0 0 0.5rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .stats-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 1.5rem;
    }

    .stats-card h2 {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin: 0 0 1rem;
    }

    .stats-value {
        font-family: var(--font-mono);
        font-size: 2rem;
        line-height: 1.2;
        color: var(--color-accent);
        margin: 0;
    }

    .stats-detail {
        color: var(--color-text-muted);
        font-size: 0.85rem;
        margin: 0.5rem 0 0;
    }

    .stats-company-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .stats-company-list li {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-text);
        font-size: 0.9rem;
    }

    .stats-company-list li:first-child {
        padding-top: 0;
    }

    .stats-company-list li:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .stats-company-list li span:last-child {
        color: var(--color-text-muted);
        white-space: nowrap;
    }

    .stats-card--wide {
        grid-column: 1 / -1;
    }

    .stats-chart {
        display: grid;
        grid-template-columns: auto auto minmax(0, 1fr);
        grid-template-rows: 12rem auto auto;
        column-gap: 0.5rem;
        margin-top: 2rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--color-text-muted);
    }

    .stats-chart-y-title {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        text-align: center;
    }

    .stats-chart-y-ticks {
        position: relative;
        min-width: 2ch;
    }

    .stats-chart-y-ticks span {
        position: absolute;
        right: 0;
        transform: translateY(50%);
    }

    .stats-chart-plot {
        position: relative;
        border-left: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
    }

    .stats-chart-plot svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .stats-chart-plot polyline,
    .stats-chart-plot line {
        fill: none;
        stroke: var(--color-accent);
        stroke-linejoin: round;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
    }

    .stats-chart-plot polyline {
        stroke-width: 2;
    }

    .stats-chart-plot line {
        stroke-width: 8;
    }

    .stats-chart-value {
        position: absolute;
        transform: translate(-50%, -0.5rem);
        color: var(--color-text);
    }

    .stats-chart-x-ticks {
        grid-column: 3;
        display: grid;
        list-style: none;
        padding: 0;
        margin: 0.5rem 0 0;
        text-align: center;
    }

    .stats-chart-x-title {
        grid-column: 3;
        text-align: center;
        margin-top: 0.25rem;
    }

    @media (max-width: 600px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
