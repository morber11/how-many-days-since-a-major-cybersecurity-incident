---
import Base from "../layouts/Base.astro";
import {
    getMostRecentIncident,
    getRecentIncidents,
    getDaysSince,
    getStatusText,
    formatDate,
    getMaxDaysBetweenIncidents,
    getMostIncidentsInOneDay,
} from "../lib/counter";

const incident = getMostRecentIncident();
const days = getDaysSince(incident.date);
const status = getStatusText(days);
const previousIncidents = getRecentIncidents();
const maxGap = getMaxDaysBetweenIncidents();
const busiestDay = getMostIncidentsInOneDay();
const isRecord = maxGap && days > maxGap.days;
const gapDetail = maxGap
    ? `[${formatDate(maxGap.dateA)}] ${maxGap.incidentA} => [${formatDate(maxGap.dateB)}] ${maxGap.incidentB}`
    : null;
    
---

<Base title="hmdsamci - Home">
    <div class="counter-page">
        <span
            class="counter-number"
            id="counter"
            data-incident-date={incident.date}>{days}</span
        >
        <p class="counter-label">
            days since the last major cybersecurity incident
        </p>
        <p class="status-line" id="status-line">{status}</p>

        <div class="incident-card">
            <h2>{incident.title}</h2>
            <p class="incident-date">
                {formatDate(incident.date)}
            </p>
            {
                incident.company && (
                    <p class="incident-company">{incident.company}</p>
                )
            }
            <p class="incident-description">{incident.description}</p>
            {
                incident.additionalNotes && (
                    <p class="incident-notes">{incident.additionalNotes}</p>
                )
            }
            <p class="incident-source">
                <a href={incident.sourceUrl} target="_blank"> Source</a>
            </p>
        </div>

        <div class="previous-incidents">
            <h3 class="previous-heading">Recent incidents</h3>
            {
                previousIncidents.map((inc) => (
                    <div class="incident-card incident-card--compact">
                        <h2>{inc.title}</h2>
                        <p class="incident-date">{formatDate(inc.date)}</p>
                        {inc.company && (
                            <p class="incident-company">{inc.company}</p>
                        )}
                        <p class="incident-description">{inc.description}</p>
                        {inc.additionalNotes && (
                            <p class="incident-notes">{inc.additionalNotes}</p>
                        )}
                        <p class="incident-source">
                            <a href={inc.sourceUrl} target="_blank">
                                Source
                            </a>
                        </p>
                    </div>
                ))
            }
        </div>

        {
            maxGap && (
                <div class="gap-stat">
                    <p>Longest gap between incidents: {maxGap.days} days</p>
                    <p class="gap-detail">{gapDetail}</p>
                    {isRecord && (
                        <p class="gap-record">
                            This is currently the highest gap on record!
                        </p>
                    )}
                </div>
            )
        }

        <div class="gap-stat">
            <p>
                Most incidents in one day was {busiestDay.count} which occurred on
                {formatDate(busiestDay.date)}
            </p>
        </div>
    </div>
</Base>

<style>
    .counter-page {
        text-align: center;
        padding: 1rem 0 0;
    }

    .counter-number {
        font-family: var(--font-mono);
        font-size: clamp(5rem, 15vw, 12rem);
        color: var(--color-accent);
        line-height: 1;
        margin: 1rem 0 0.5rem;
    }

    .counter-label {
        font-family: var(--font-mono);
        font-size: 1rem;
        color: var(--color-text-muted);
        text-transform: lowercase;
        margin: 0 0 2rem;
    }

    .status-line {
        font-style: italic;
        color: var(--color-text-muted);
        font-size: 1.1rem;
        margin: 0 0 3rem;
    }

    .previous-heading {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--color-text-muted);
        text-align: center;
        margin: 2rem 0 1rem;
    }

    .previous-incidents {
        margin-top: 2rem;
    }

    .gap-stat {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--color-text-muted);
        text-align: center;
        margin: 1rem 0 0;
    }

    .gap-stat p {
        margin: 0.25rem 0;
    }

    .gap-detail {
        font-size: 0.75rem;
    }

    .gap-record {
        color: var(--color-accent);
    }
</style>

<script>
    // dodgy work around - recompile it here so the statusText is accurate
    import { getStatusText } from "../lib/counter";

    const el = document.getElementById("counter");
    const statusEl = document.getElementById("status-line");

    if (el && statusEl) {
        const incidentDate = new Date(el.dataset.incidentDate ?? "");
        const today = new Date();

        today.setHours(0, 0, 0, 0);
        incidentDate.setHours(0, 0, 0, 0);

        const days = Math.floor(
            (today.getTime() - incidentDate.getTime()) / 86400000,
        );

        el.textContent = String(days);
        statusEl.textContent = getStatusText(days);
    }
</script>
